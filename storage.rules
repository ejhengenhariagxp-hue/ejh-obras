// Regras de segurança do Firebase Storage para o projeto ejh-obras
// ════════════════════════════════════════════════════════════════════
//
// COMO APLICAR:
// 1. Abra https://console.firebase.google.com/project/ejh-obras/storage/rules
// 2. Cole o conteúdo do bloco "rules_version" abaixo (incluindo a linha)
// 3. Clique em "Publicar"
//
// O QUE FAZ:
// - Cada usuário só pode ler/escrever em sua própria pasta usuarios/{uid}/
// - Outros usuários não conseguem acessar os arquivos
// - Tamanho máximo: 10MB por arquivo (proteção contra upload acidental)
// - Apenas tipos de imagem aceitos
//
// ════════════════════════════════════════════════════════════════════

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /usuarios/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Em uploads novos (resource == null), o contentType e size vêm em
      // request.resource. Antes a regra usava `resource == null ||` o que
      // sempre passava nessa condição → qualquer tipo de arquivo aceito.
      // Agora validamos request.resource em todos os casos.
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
