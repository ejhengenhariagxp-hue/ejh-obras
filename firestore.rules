// Regras de segurança do Cloud Firestore para o projeto ejh-obras
// ════════════════════════════════════════════════════════════════════
//
// COMO APLICAR:
// 1. Abra https://console.firebase.google.com/project/ejh-obras/firestore/rules
// 2. Apaga as regras atuais
// 3. Cola o conteúdo abaixo (a partir de "rules_version")
// 4. Clica em "Publicar"
//
// O QUE FAZ:
// - Cada usuário só lê/escreve em seu próprio documento `usuarios/{uid}`
// - Sub-coleções (ex.: `usuarios/{uid}/diario`) seguem mesma regra
// - Bloqueia totalmente acesso a outros usuários
//
// ════════════════════════════════════════════════════════════════════

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Documento principal do usuário e tudo abaixo dele
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Sub-coleções (diario, etc.)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Bloqueio explícito de qualquer outra coleção
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
